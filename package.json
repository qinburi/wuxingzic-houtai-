{
  "name": "hannao-intangible-assets-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev:admin": "vite --config admin/vite.config.js --host 127.0.0.1 --port 5174",
    "dev:server": "npm run build:server && npm run start:server",
    "dev:collector": "node collector/server.mjs",
    "start:server": "node --enable-source-maps server/dist/server/src/main.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "build:pages": "npm run build:admin && node scripts/publish-admin-pages.mjs",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:admin && npm run build:server",
    "build:all": "npm run build",
    "test": "npm run test:admin && npm run test:server",
    "test:admin": "node --test admin/test/*.test.js",
    "test:server": "tsx --test server/test/*.test.ts"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@lucide/vue": "^1.26.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@vitejs/plugin-vue": "^6.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "vite": "^8.1.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
